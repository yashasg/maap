# Copy to a root-owned .env OUTSIDE the source checkout. Never use example credentials.
# Published tag for the approved release's full Git commit SHA (not latest).
UMAMI_IMAGE=ghcr.io/yashasg/umami-td
UMAMI_IMAGE_TAG=
# Generate each value independently with openssl rand -hex 32.
# POSTGRES_PASSWORD is inserted in a URL; use hex, not unescaped URI punctuation.
POSTGRES_PASSWORD=
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
# Remotely managed Cloudflare Tunnel connector token. Not an API or Access token.
TUNNEL_TOKEN=
# Synthetic analytics hostname; not your public tunnel/SDK URL.
TD_HOSTNAME=app.ios
# Optional existing TEST website UUID, distinct from the production website UUID.
TD_TEST_WEBSITE_ID=
# Blank keeps non-TelemetryDeck.* keys and four SDK keys. To limit event properties,
# replace with an exact comma-separated list (e.g. TelemetryDeck.AppInfo.version,surface).
TD_ALLOWED_KEYS=
